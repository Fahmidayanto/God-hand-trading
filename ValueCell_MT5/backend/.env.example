# ==============================================
# God Hand Trading Backend - Environment Config
# ==============================================

# Application
APP_NAME=God Hand Trading Backend
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# API Settings
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# MT5 Configuration
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_TIMEOUT=60000

# Trading Settings
TRADING_SYMBOL=XAUUSD
TRADING_MODE=paper  # paper or live
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3

# Database
DATABASE_URL=sqlite:///./godhand.db
DATABASE_ECHO=false

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Agents & LLM Providers
CONSENSUS_THRESHOLD=0.70
AGENT_WEIGHT_STRUCTURE=0.35
AGENT_WEIGHT_ML=0.30
AGENT_WEIGHT_RISK=0.20
AGENT_WEIGHT_SENTIMENT=0.15

# LLM Providers (Optional)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
NINEINFERENCE_API_KEY=
AGENTROUTER_API_KEY=
IAMHC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# PostgreSQL / Neon (Optional)
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
