# ==============================================
# Trading System Environment Variables
# ==============================================
# Copy this file to .env and fill in your credentials

# Telegram Bot Configuration
# ---------------------------
# Get your bot token from @BotFather on Telegram
# Steps:
#   1. Message @BotFather on Telegram
#   2. Send /newbot and follow instructions
#   3. Copy the token you receive
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID
# Steps:
#   1. Message your bot (send any message)
#   2. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   3. Look for "chat":{"id": YOUR_CHAT_ID
#   4. Copy your chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# MT5 Configuration (Optional)
# ----------------------------
# MT5_LOGIN=your_mt5_login
# MT5_PASSWORD=your_mt5_password
# MT5_SERVER=your_mt5_server

# Trading Parameters (Optional - defaults used if not set)
# --------------------------------------------------------
# MAX_CONSECUTIVE_LOSSES=3
# MAX_DAILY_LOSS_PCT=5.0
# COOLDOWN_MINUTES=60
# ACCOUNT_BALANCE=10000.0

# LLM MSA Suniesis Provider (Optional)
# ------------------------------------
# SUNIESIS_API_KEY=your_suniesis_api_key_here
